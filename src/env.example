SQL_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=mi-servidor;DATABASE=Premedic;UID=webhook_worker;PWD=cambiar;TrustServerCertificate=yes

# Credenciales por destino (WEBHOOK_<CODIGO>_CLIENT / _SECRET)
WEBHOOK_AUTORIZACIONES_CLIENT=premedic-client-id
WEBHOOK_AUTORIZACIONES_SECRET=premedic-secret

# Opcional: credenciales por defecto para cualquier destino
# WEBHOOK_CLIENT=
# WEBHOOK_SECRET=

WEBHOOK_LOTE=50
WEBHOOK_HILOS=8
WEBHOOK_POLL_SEG=5
LOG_LEVEL=INFO
